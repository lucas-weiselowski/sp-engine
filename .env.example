# ── Ollama ────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ── NetBox ────────────────────────────────────────────────
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=

# ── Ansible ───────────────────────────────────────────────
ANSIBLE_HOST_KEY_CHECKING=False
ANSIBLE_STDOUT_CALLBACK=yaml
ANSIBLE_COLLECTIONS_PATH=/workspace/collections
ASNIBLE_VAULT_PASSWORD_FILE=./.vaultpass
# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=/var/log/sp-engine.log

# ── Git ───────────────────────────────────────────────────
GIT_USER=
GIT_EMAIL=

# ── User ───────────────────────────────────────────────────
DEVOPS_USER=
DEVOPS_PASS=